<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NetworkMonitor.Maui.ViewModels;assembly=NetworkMonitorMaui"
             x:Class="QuantumSecure.NetworkMonitorPage"
             x:DataType="vm:NetworkMonitorViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <Style x:Key="CardFrameStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"/>
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HasShadow" Value="True"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{DynamicResource Secondary}"/>
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="24"
                                 Padding="24,32,24,48">

                <VerticalStackLayout Spacing="6"
                                     HorizontalOptions="Center">
                    <Image Source="logo.png"
                           SemanticProperties.Description="Quantum Secure logo"
                           HeightRequest="96"
                           HorizontalOptions="Center"/>
                    <Label Text="Quantum Secure"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource Primary}"/>
                    <Label Text="Quickly test connectivity to any host before adding it to your monitoring plan."
                           Style="{StaticResource SectionCaptionStyle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           WidthRequest="340"/>
                </VerticalStackLayout>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <VerticalStackLayout Spacing="18">
                        <Label Text="Connection test"
                               Style="{StaticResource SectionTitleStyle}"/>
                        <Label Text="Choose the endpoint type, provide the host address, and optionally specify a port."
                               Style="{StaticResource SectionCaptionStyle}"/>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Endpoint type"
                                   Style="{StaticResource InputLabelStyle}"/>
                            <Picker ItemsSource="{Binding EndpointTypes}"
                                    SelectedItem="{Binding SelectedEndpointType}"
                                    Title="Select an endpoint"
                                    HorizontalOptions="Fill"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Host address"
                                   Style="{StaticResource InputLabelStyle}"/>
                            <Entry Text="{Binding Address}"
                                   Placeholder="e.g. 10.0.0.12 or api.quantumsecure.io"
                                   HorizontalOptions="Fill"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Port (optional)"
                                   Style="{StaticResource InputLabelStyle}"/>
                            <Entry Text="{Binding Port}"
                                   Placeholder="Leave empty for default"
                                   Keyboard="Numeric"
                                   HorizontalOptions="Fill"/>
                        </VerticalStackLayout>

                        <Button Text="Test connection"
                                Command="{Binding TestConnectionCommand}"
                                HorizontalOptions="Fill"
                                FontAttributes="Bold"/>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}"
                       IsVisible="{Binding HasResult}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Test result"
                               Style="{StaticResource SectionTitleStyle}"/>
                        <Label Text="{Binding ResultMessage}"
                               Style="{StaticResource SectionCaptionStyle}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
                        <Label Text="{Binding ResponseTime, StringFormat='Response time: {0} ms'}"
                               Style="{StaticResource SectionCaptionStyle}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                        <Label Text="{Binding ResultStatus}"
                               Style="{StaticResource InputLabelStyle}"
                               TextColor="{DynamicResource Primary}"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
