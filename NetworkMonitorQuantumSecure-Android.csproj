<Project Sdk="Microsoft.NET.Sdk.Razor">
        <PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		 <RollForward>Minor</RollForward>
                <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
                <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
                <OutputType>Exe</OutputType>
                <RootNamespace>QuantumSecure</RootNamespace>
                <UseMaui>true</UseMaui>
                <SingleProject>true</SingleProject>
                <SelfContained>true</SelfContained>
                <ImplicitUsings>enable</ImplicitUsings>
                <!-- Display name -->
                <ApplicationTitle>Quantum Secure</ApplicationTitle>
                <!-- App Identifier -->
                <ApplicationId>click.freenetworkmonitor.quantumsecure</ApplicationId>
                <ApplicationIdGuid>d4f21b0e-2c97-4c50-b003-dca43bd9a888</ApplicationIdGuid>
                <!-- Versions -->
                <ApplicationDisplayVersion>0.7.1</ApplicationDisplayVersion>
                <ApplicationVersion>710</ApplicationVersion>
                <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
                <AndroidSdkDirectory>/usr/lib/android-sdk</AndroidSdkDirectory>
                <Nullable>enable</Nullable>
                <NoWarn>CS8618</NoWarn>
                <RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm;android-arm64;</RuntimeIdentifiers>
                <AndroidBundleConfigurationFile>BundleConfig.json</AndroidBundleConfigurationFile>
                <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>

        </PropertyGroup>
        <PropertyGroup Condition="'$(Configuration)'=='Release-Dev'">
                <DefineConstants>DEV</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU' or '$(Configuration)'=='Release-Dev'">
                <AndroidPackageFormat>aab</AndroidPackageFormat>
                <AndroidSigningKeyAlias>networkmonitormaui</AndroidSigningKeyAlias>
                <AndroidSigningKeyStore>/home/mahadeva/code/securefiles/networkmonitormaui.keystore</AndroidSigningKeyStore>
                <AndroidSigningKeyPass>$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningKeyPass>
                <AndroidSigningStorePass>$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningStorePass>
                <AndroidKeyStore>true</AndroidKeyStore>
                <Optimize>true</Optimize>
                <PublishTrimmed>false</PublishTrimmed>
                <RunAOTCompilation>false</RunAOTCompilation>
                <EnableDefaultStaticWebAssets>true</EnableDefaultStaticWebAssets>
        </PropertyGroup>

        <ItemGroup>
                <!-- App Icon -->
                <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />
                <!-- Splash Screen -->
                <MauiSplashScreen Include="Resources\Splash\splashsafe.svg" Color="#FFFFFF" BaseSize="432,432" />
                <!-- Images -->
                <MauiImage Include="Resources\Images\*" />
                <!--<MauiImage Update="Resources\Images\logo.svg" BaseSize="168,208" /> -->
                <!-- Custom Fonts -->
                <MauiFont Include="Resources\Fonts\*" />
                <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
                <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\openssl-windows\**;Resources\Raw\windowsdlls\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
                <MauiStyles Include="Resources\Styles\*" />
        </ItemGroup>


   <ItemGroup>
    <AndroidNativeLibrary Include="Platforms/Android/jniLibs/arm64-v8a/libprocwrapper.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
